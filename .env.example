# Environment for the OSINT investigation engine. Copy to the root of your
# working repo as `.env` and fill in what you need, then make sure these land in
# the launch/runner environment (for the omnigent deployment, name them in
# OMNIGENT_RUNNER_ENV_PASSTHROUGH). SEARXNG_URL and CRAWL4AI_URL MUST be present
# in the environment — the searxng and crawl4ai MCP configs carry no config-level
# default (this file sets both to localhost for you). CRAWL4AI_HOST (the REST
# selftest base) still defaults to localhost on its own. GLEIF, the UK Gazette,
# and WIPO are keyless. Add the rest as your leads need them.

# --- crawl4ai (fetch + snapshot) -------------------------------------------
# REST base used by bin/capture-evidence.sh, bin/harness-selftest.sh.
CRAWL4AI_HOST=http://localhost:11235
# MCP SSE endpoint used by agents/*/tools/mcp/crawl4ai.yaml (full path).
CRAWL4AI_URL=http://localhost:11235/mcp/sse
# Bearer token for both of the above. Leave empty for a local container with no
# auth configured.
CRAWL4AI_API_TOKEN=

# --- SearXNG (web search) ---------------------------------------------------
SEARXNG_URL=http://localhost:8080

# --- Stealth browser capture (bin/capture-stealth.py) -----------------------
# Chrome DevTools Protocol endpoint for an already-running stealth browser.
CLOAK_CDP_URL=http://localhost:9222

# --- Registry / court API clients (bin/) — free keys, uncomment when a lead
# needs them. GLEIF, the UK Gazette, and WIPO need no key at all.
# UK Companies House — https://developer.company-information.service.gov.uk/
# COMPANIES_HOUSE_API_KEY=
# CourtListener (US courts / RECAP) — https://www.courtlistener.com/help/api/
# COURTLISTENER_TOKEN=
# USPTO TSDR (US trademarks) — USPTO Open Data Portal
# USPTO_API_KEY=

# --- Deployment (omnigent runner / run.sh) ----------------------------------
# Base branch run.sh checks out and fast-forward pulls before launching. Set to
# `main` if your deployment's default branch is `main`.
# OSINT_BRANCH=master
# Git remote run.sh pulls from.
# OSINT_REMOTE=origin
# omnigent server this bundle is launched against.
# OMNIGENT_SERVER=http://omnigent:8000
# Same server, read by eval/eval_metrics.py when scoring a run.
# OMNIGENT_URL=http://omnigent:8000
